# Copie para .env.local e preencha com os dados do app Web do seu projeto
# Firebase (Console → Configurações do projeto → Seus apps → SDK).
# Sem estas variáveis, a plataforma roda no MODO LOCAL (dados só no navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 1 = usar os emuladores locais (npm run emuladores) em vez do projeto real
VITE_FIREBASE_EMULADORES=
