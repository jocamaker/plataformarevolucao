rules_version = '2';

// Arquivos: o banco guarda só a referência; aqui ficam os PDFs, vídeos e fotos.
// O papel vem do Firestore (usuarios/{uid}.role).

service firebase.storage {
  match /b/{bucket}/o {

    function logado() { return request.auth != null; }
    function perfil() { return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return logado() && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) && perfil().get('ativo', true) != false; }
    function moderador() { return ativo() && perfil().role == 'moderador'; }
    function eu(uid) { return ativo() && request.auth.uid == uid; }
    function apagando() { return request.resource == null; }
    function mb(n) { return n * 1024 * 1024; }
    function pdf() { return request.resource.contentType == 'application/pdf' && request.resource.size <= mb(25); }
    function imagem(max) { return request.resource.contentType.matches('image/.*') && request.resource.size <= mb(max); }
    function midia() { return (request.resource.contentType.matches('video/.*') && request.resource.size <= mb(2048)) || imagem(10); }

    // materiais em PDF: todos os logados leem; só o moderador envia
    match /materiais/{id}/{arquivo} {
      allow read: if ativo();
      allow write: if moderador() && (apagando() || pdf());
    }

    // PDF do simulado: o próprio aluno e o moderador
    match /simulados/{alunoId}/{arquivo} {
      allow read: if moderador() || eu(alunoId);
      allow write: if (moderador() || eu(alunoId)) && (apagando() || pdf());
    }

    // vídeos e capas dos cursos
    match /playlists/{id}/{arquivo} {
      allow read: if ativo();
      allow write: if moderador() && (apagando() || midia());
    }

    // fotos e textos anexados às redações: só o aluno dono e o moderador
    match /redacoes/{alunoId}/{arquivo} {
      allow read: if moderador() || eu(alunoId);
      allow write: if moderador() && (apagando() || imagem(15) || pdf());
    }

    // imagens da página inicial (aparecem antes do login)
    match /publico/{arquivo} {
      allow read: if true;
      allow write: if moderador() && (apagando() || imagem(10));
    }
  }
}
